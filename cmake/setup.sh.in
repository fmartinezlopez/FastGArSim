#!/bin/sh
# setup.sh -- generated by CMake, do not edit
#
# Source this file to use a FastGArSim build from any directory:
#
#     source @FASTGARSIM_ENV_BUILD_DIR@/setup.sh
#     GArAnalysis -a TruncatedDEDX.C -i sim.root -o dedx.root
#
# GArSimulation, GArReconstruction and GArAnalysis find their macros through
# FASTGARSIM_MACRO_PATH and their own location, so they can be started from any
# directory:
#
#     GArSimulation -m macros/gun.mac    # batch
#     GArSimulation -v                   # interactive viewer, runs macros/vis.mac
#
# It puts the executables on PATH, the shared libraries on the dynamic loader
# path and the headers on ROOT_INCLUDE_PATH -- the same environment that
# rootlogon.C sets up when ROOT is started from the build directory itself.
#
# This does *not* set up Geant4 and ROOT themselves. On the FNAL machines run
# `source <source>/setup_fnal.sh` instead, which does both.

export FASTGARSIM_BUILD="@FASTGARSIM_ENV_BUILD_DIR@"
export FASTGARSIM_COMPONENTS="@FASTGARSIM_ENV_COMPONENTS@"
# Searched by GArSimulation for its run macros, and by ROOT via rootlogon.C
export FASTGARSIM_MACRO_PATH="@FASTGARSIM_ENV_MACRO_PATH@"

export PATH="@FASTGARSIM_ENV_BIN_PATH@${PATH:+:$PATH}"
export LD_LIBRARY_PATH="@FASTGARSIM_ENV_LIB_PATH@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export DYLD_LIBRARY_PATH="@FASTGARSIM_ENV_LIB_PATH@${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
export ROOT_INCLUDE_PATH="@FASTGARSIM_ENV_INCLUDE_PATH@${ROOT_INCLUDE_PATH:+:$ROOT_INCLUDE_PATH}"

# ROOT only picks up rootlogon.C and .rootrc from the current working
# directory. The paths exported above cover the usual cases on their own -- the
# dictionaries are autoloaded from their .rootmap files -- but the generated
# rootlogon.C also loads libGArAnalysis:
#
#     root -l "$FASTGARSIM_ROOTLOGON"
#
# To get it in every session, add this line to ~/.rootrc:
#
#     Rint.Logon: <this build>/rootlogon.C
export FASTGARSIM_ROOTLOGON="${FASTGARSIM_BUILD}/rootlogon.C"

# Naming a macro on the ROOT command line is resolved before any logon file
# runs, so that case needs ROOT's macro path, which only a .rootrc can set in
# time. One is generated next to this script for use from the build directory.
# For any other directory, add this line to ~/.rootrc once -- it reads the
# variable below, so it follows whichever build you set up:
#
#     Unix.*.Root.MacroPath: .:$(FASTGARSIM_MACRO_PATH):$(ROOTSYS)/macros

echo "FastGArSim environment set up:"
echo "    build      : ${FASTGARSIM_BUILD}"
echo "    components : ${FASTGARSIM_COMPONENTS}"
echo "    macros     : ${FASTGARSIM_MACRO_PATH}"
