// rootlogon.C -- generated by CMake, do not edit
//
// Automatically executed when ROOT is started from this build directory, so
// that macros can simply do
//
//     #include "AnalysisBase.hh"
//
// and read files written with the FastGArSim data types without loading
// anything by hand.
{
    // Header search paths, for both the interpreter and ACLiC
@FASTGARSIM_ROOTLOGON_INCLUDES@
    // Shared library search paths
@FASTGARSIM_ROOTLOGON_PATHS@
    // Dictionaries and the analysis library
@FASTGARSIM_ROOTLOGON_LOADS@
    // Macro search path, so that the macros can be named without their directory
@FASTGARSIM_ROOTLOGON_MACROPATH@
    Info("rootlogon", "FastGArSim (@FASTGARSIM_ENV_COMPONENTS@) loaded");
}
