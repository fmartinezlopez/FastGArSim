# .rootrc -- generated by CMake, do not edit
#
# Read by ROOT when it is started from this directory. It puts the FastGArSim
# macros on ROOT's macro search path.
#
# This has to be done here rather than in rootlogon.C: a macro named on the
# command line is resolved by TApplication::GetOptions while ROOT is still
# being constructed, which is before any logon file runs. So
#
#     root -l -q 'MakeNtuple.C("sim.root", "ntuple.root")'
#
# only works if the macro path was already set, i.e. from a .rootrc.
#
# To get the same from *any* directory, put this line in ~/.rootrc instead.
# FASTGARSIM_MACRO_PATH is exported by setup.sh, so it follows whichever build
# was set up last and needs no editing when you rebuild or switch builds:
#
#     Unix.*.Root.MacroPath: .:$(FASTGARSIM_MACRO_PATH):$(ROOTSYS)/macros

Unix.*.Root.MacroPath: .:@FASTGARSIM_ENV_MACRO_PATH@:$(ROOTSYS)/macros
